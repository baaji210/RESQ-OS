# RESQ-OS Backend Environment Configuration Example
# Copy to .env and configure values as needed.

# Database Configuration
# Default is local SQLite (no credentials required)
DATABASE_URL=sqlite:///./resq_os.db

# MongoDB Atlas Configuration (Set in .env to connect to Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=RESQ_OS

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulation Mode (Always true for demo/hackathon environments)
SIMULATION_MODE=true

# Optional LLM API Keys (If left empty, system uses deterministic rule-based engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
